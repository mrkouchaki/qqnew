misroutes = strong[strong["MISROUTE_LABEL"] == 1].copy()

global_misroute_rate = strong["MISROUTE_LABEL"].mean()


# ------------------------------------------------------------
# Wilson lower confidence bound
# Prevents tiny groups from ranking too highly
# ------------------------------------------------------------

def wilson_lower_pct(successes, total, z=1.96):
    successes = np.asarray(successes, dtype=float)
    total = np.asarray(total, dtype=float)

    p = successes / total
    denominator = 1 + (z**2 / total)

    center = p + (z**2 / (2 * total))

    margin = z * np.sqrt(
        (p * (1 - p) / total)
        + (z**2 / (4 * total**2))
    )

    return 100 * (center - margin) / denominator


# ------------------------------------------------------------
# 1. Actual PSAP -> Expected PSAP summary
# ------------------------------------------------------------

pair_summary = (
    misroutes.groupby(
