# ------------------------------------------------------------
# Normalize fields
# ------------------------------------------------------------

def normalize_id(series):
    result_series = (
        series.astype("string")
        .str.strip()
        .str.replace('"', "", regex=False)
        .str.replace(r"\.0+$", "", regex=True)
        .str.upper()
    )

    result_series = result_series.mask(
        result_series.isin(["", "NAN", "NONE", "NULL", "<NA>"])
    )

    return result_series.fillna("<MISSING>")


id_columns = [
    "FCC_PSAP_ID",
    "EXPECTED_FCC_PSAP_ID",
    "ENBID",
    "USID",
    "SETUP_ECGI_HEX",
    "ESRK",
]

for column in id_columns:
    if column not in calls.columns:
        calls[column] = "<MISSING>"

    calls[column] = normalize_id(calls[column])


numeric_columns = [
    "UNCERT_METERS",
