# 5. Daily trend
# ------------------------------------------------------------

daily_summary = (
    strong.dropna(subset=["CALL_DAY"])
    .groupby("CALL_DAY")
    .agg(
        TOTAL_STRONG_CALLS=("MISROUTE_LABEL", "size"),
        MISROUTE_CALLS=("MISROUTE_LABEL", "sum"),
    )
    .reset_index()
)

daily_summary["MISROUTE_RATE_PCT"] = (
    100
    * daily_summary["MISROUTE_CALLS"]
    / daily_summary["TOTAL_STRONG_CALLS"]
)


