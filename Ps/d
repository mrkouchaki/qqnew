# ------------------------------------------------------------
# 2. Entity-level root-cause analysis
# ------------------------------------------------------------

def classify_candidate(row):
    misroute_count = row["MISROUTE_CALLS"]

    if misroute_count == 0:
        return "NO_MISROUTE"

    pair_share = row.get("TOP_PAIR_SHARE_PCT", 0)
    distance_ratio = row.get("MEDIAN_DISTANCE_UNCERT_RATIO", np.nan)
    distinct_expected = row.get("DISTINCT_EXPECTED_PSAPS", 0)
    level = row["LEVEL"]

    clear_separation = (
        pd.notna(distance_ratio) and distance_ratio >= 3
    )

    if (
        misroute_count >= 3
        and pair_share >= 80
        and clear_separation
    ):
        if level in ["ECGI", "ENBID_USID", "ENBID_USID_ECGI"]:
            return "LIKELY_CELL_TO_PSAP_MAPPING"

        if level == "ESRK":
            return "LIKELY_ESRK_TO_PSAP_MAPPING"

        if level == "ENBID":
            return "LIKELY_ENB_TO_PSAP_MAPPING"

        return "REPEATED_PSAP_ROUTING_MAPPING"

    if misroute_count >= 3 and distinct_expected > 1:
        return "UNSTABLE_OR_MULTIPLE_EXPECTED_PSAP_PATTERN"

    if not clear_separation:
        return "NEAR_BOUNDARY_OR_LOCATION_REVIEW"

    if misroute_count >= 2:
        return "REPEATED_PATTERN_LOW_SUPPORT"

    return "ISOLATED_MISROUTE"


def build_entity_summary(level, keys):
    base = (
        strong.groupby(keys, dropna=False)
        .agg(
            TOTAL_STRONG_CALLS=("MISROUTE_LABEL", "size"),
            MISROUTE_CALLS=("MISROUTE_LABEL", "sum"),
            FIRST_CALL_UTC=("CALL_TS", "min"),
            LAST_CALL_UTC=("CALL_TS", "max"),
        )
        .reset_index()
    )

    misroute_details = (
        misroutes.groupby(keys, dropna=False)
        .agg(
            DISTINCT_EXPECTED_PSAPS=(
                "EXPECTED_FCC_PSAP_ID",
                "nunique",
            ),
            MISROUTE_ACTIVE_DAYS=("CALL_DAY", "nunique"),
            MEDIAN_DISTANCE_M=(
                "DISTANCE_TO_ROUTED_BOUNDARY_M",
                "median",
            ),
            P95_DISTANCE_M=(
                "DISTANCE_TO_ROUTED_BOUNDARY_M",
                lambda x: x.quantile(0.95),
            ),
            MEDIAN_UNCERTAINTY_M=("UNCERT_METERS", "median"),
            MEDIAN_DISTANCE_UNCERT_RATIO=(
                "DISTANCE_UNCERT_RATIO",
                "median",
            ),
        )
        .reset_index()
    )

    top_pair_group = list(keys)

    if "FCC_PSAP_ID" not in top_pair_group:
        top_pair_group.append("FCC_PSAP_ID")

    if "EXPECTED_FCC_PSAP_ID" not in top_pair_group:
        top_pair_group.append("EXPECTED_FCC_PSAP_ID")

    top_pair = (
        misroutes.groupby(top_pair_group, dropna=False)
        .size()
        .reset_index(name="TOP_PAIR_MISROUTES")
        .sort_values("TOP_PAIR_MISROUTES", ascending=False)
        .drop_duplicates(subset=keys)
    )

    rename_columns = {
        "FCC_PSAP_ID": "TOP_ROUTED_FCC_PSAP_ID",
        "EXPECTED_FCC_PSAP_ID": "TOP_EXPECTED_FCC_PSAP_ID",
    }

    for column in keys:
        rename_columns.pop(column, None)

    top_pair = top_pair.rename(columns=rename_columns)

    output = base.merge(
        misroute_details,
        on=keys,
        how="left",
    )

    output = output.merge(
        top_pair,
        on=keys,
        how="left",
    )

    if "TOP_ROUTED_FCC_PSAP_ID" not in output.columns:
        output["TOP_ROUTED_FCC_PSAP_ID"] = output["FCC_PSAP_ID"]

    fill_zero_columns = [
        "MISROUTE_CALLS",
        "DISTINCT_EXPECTED_PSAPS",
        "MISROUTE_ACTIVE_DAYS",
        "TOP_PAIR_MISROUTES",
    ]

    for column in fill_zero_columns:
        output[column] = output[column].fillna(0).astype(int)

    output["MISROUTE_RATE_PCT"] = (
        100
        * output["MISROUTE_CALLS"]
        / output["TOTAL_STRONG_CALLS"]
    )

    output["WILSON_LOWER_RATE_PCT"] = wilson_lower_pct(
        output["MISROUTE_CALLS"],
        output["TOTAL_STRONG_CALLS"],
    )

    output["TOP_PAIR_SHARE_PCT"] = np.where(
        output["MISROUTE_CALLS"] > 0,
        100
        * output["TOP_PAIR_MISROUTES"]
        / output["MISROUTE_CALLS"],
        0,
    )

    output["LEVEL"] = level

    output["KEY_COMPLETE"] = True
    for column in keys:
        output["KEY_COMPLETE"] &= output[column].ne("<MISSING>")

    output["ROOT_CAUSE_HYPOTHESIS"] = output.apply(
        classify_candidate,
        axis=1,
    )

    return output


entity_levels = {
    "ROUTED_PSAP": ["FCC_PSAP_ID"],
    "ENBID": ["ENBID"],
    "USID": ["USID"],
    "ECGI": ["SETUP_ECGI_HEX"],
    "ESRK": ["ESRK"],
    "ENBID_USID": ["ENBID", "USID"],
    "ENBID_USID_ECGI": [
        "ENBID",
        "USID",
        "SETUP_ECGI_HEX",
    ],
}

entity_tables = [
    build_entity_summary(level, keys)
    for level, keys in entity_levels.items()
]

entity_risk = pd.concat(
    entity_tables,
    ignore_index=True,
    sort=False,
)

root_cause_candidates = entity_risk[
    entity_risk["KEY_COMPLETE"]
    & (entity_risk["TOTAL_STRONG_CALLS"] >= 5)
    & (entity_risk["MISROUTE_CALLS"] >= 3)
].copy()

root_cause_candidates = root_cause_candidates.sort_values(
    [
        "MISROUTE_CALLS",
        "WILSON_LOWER_RATE_PCT",
        "TOP_PAIR_SHARE_PCT",
        "MEDIAN_DISTANCE_M",
    ],
    ascending=[False, False, False, False],
).reset_index(drop=True)


