    "LOCATE_ECGI_VALIDATION",
    "SOURCE_911LOG",
    "SUMMARY_YN",
    "EMAIL_YN",
    "TEXTMSG_YN",
]

feature_rows = []

for feature in categorical_candidates:
    if feature not in strong.columns:
        continue

    temporary = strong[[feature, "MISROUTE_LABEL"]].copy()

    temporary["FEATURE_VALUE"] = (
        temporary[feature]
        .astype("string")
        .str.strip()
        .str.upper()
        .fillna("<MISSING>")
        .replace("", "<MISSING>")
    )

    summary = (
        temporary.groupby("FEATURE_VALUE", dropna=False)
        .agg(
            TOTAL_STRONG_CALLS=("MISROUTE_LABEL", "size"),
            MISROUTE_CALLS=("MISROUTE_LABEL", "sum"),
        )
        .reset_index()
    )

    summary["FEATURE"] = feature
    summary["MISROUTE_RATE_PCT"] = (
        100
        * summary["MISROUTE_CALLS"]
        / summary["TOTAL_STRONG_CALLS"]
    )

    summary["RATE_LIFT_VS_GLOBAL"] = (
        summary["MISROUTE_RATE_PCT"]
        / (100 * global_misroute_rate)
    )

    summary["EXPECTED_MISROUTES_AT_BASELINE"] = (
        summary["TOTAL_STRONG_CALLS"]
        * global_misroute_rate
    )

    summary["EXCESS_MISROUTES"] = (
        summary["MISROUTE_CALLS"]
        - summary["EXPECTED_MISROUTES_AT_BASELINE"]
    )

    feature_rows.append(summary)

if feature_rows:
    feature_risk = pd.concat(
        feature_rows,
        ignore_index=True,
    )

    feature_risk = feature_risk[
        (feature_risk["TOTAL_STRONG_CALLS"] >= 10)
        & (feature_risk["MISROUTE_CALLS"] >= 2)
    ].copy()

    feature_risk = feature_risk.sort_values(
        [
            "EXCESS_MISROUTES",
            "MISROUTE_CALLS",
            "RATE_LIFT_VS_GLOBAL",
        ],
        ascending=[False, False, False],
    ).reset_index(drop=True)

else:
    feature_risk = pd.DataFrame()


# ------------------------------------------------------------
# 4. Numeric feature comparison
# ------------------------------------------------------------

numeric_comparison_rows = []

for feature in numeric_columns:
    if feature not in strong.columns:
        continue

    correct_values = strong.loc[
        strong["MISROUTE_LABEL"] == 0,
        feature,
    ].dropna()

    misroute_values = strong.loc[
        strong["MISROUTE_LABEL"] == 1,
        feature,
    ].dropna()

    if len(misroute_values) == 0:
        continue

    correct_median = correct_values.median()
    misroute_median = misroute_values.median()

    numeric_comparison_rows.append({
        "FEATURE": feature,
        "CORRECT_NON_NULL": len(correct_values),
        "MISROUTE_NON_NULL": len(misroute_values),
        "CORRECT_MEDIAN": correct_median,
        "MISROUTE_MEDIAN": misroute_median,
        "MEDIAN_DIFFERENCE": misroute_median - correct_median,
        "CORRECT_P90": correct_values.quantile(0.90),
        "MISROUTE_P90": misroute_values.quantile(0.90),
    })

numeric_comparison = pd.DataFrame(numeric_comparison_rows)


