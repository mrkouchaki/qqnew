    str(c).strip().upper().replace(" ", "_")
    for c in investigation.columns
]

if investigation.columns.duplicated().any():
    raise ValueError("Duplicate column names found in v5 output.")

columns = list(investigation.columns)


def first_existing(*names):
    for name in names:
        if name in columns:
            return name
    return None


def find_mode(prefix, population):
    expected_suffix = f"_{population}_MODE"

    for c in columns:
        if c.startswith(prefix) and c.endswith(expected_suffix):
            return c

    return None


def numeric_series(column, default=0.0):
    if column is None:
        return pd.Series(default, index=investigation.index, dtype="float64")

    return pd.to_numeric(
        investigation[column],
        errors="coerce"
    ).fillna(default)


# ------------------------------------------------------------
# 2. Rank investigations
# ------------------------------------------------------------

misroute_col = first_existing(
    "MISROUTE_CALLS",
    "COHORT_MISROUTE_CALLS"
)

strong_col = first_existing(
    "TOTAL_STRONG_CALLS",
    "COHORT_TOTAL_STRONG_CALLS"
)

control_col = first_existing(
    "MATCHED_CORRECT_CONTROL_CALLS",
    "CORRECT_CONTROL_CALLS"
)

score_col = first_existing("CORROBORATION_SCORE")

investigation["_SORT_SCORE"] = numeric_series(score_col)
investigation["_SORT_MISROUTES"] = numeric_series(misroute_col)
investigation["_SORT_CONTROLS"] = numeric_series(control_col)

ranked = (
    investigation
    .sort_values(
        ["_SORT_SCORE", "_SORT_MISROUTES", "_SORT_CONTROLS"],
        ascending=[False, False, False],
        kind="stable"
    )
    .head(100)
    .drop(columns=[
        "_SORT_SCORE",
        "_SORT_MISROUTES",
        "_SORT_CONTROLS"
    ])
    .copy()
)

ranked.insert(0, "PRESENTATION_RANK", range(1, len(ranked) + 1))


# ------------------------------------------------------------
# 3. Determine important network/signaling columns
# ------------------------------------------------------------

route_status_case = find_mode("ROUTE_STATUS_GMLC", "MISROUTE")
route_status_control = find_mode("ROUTE_STATUS_GMLC", "CONTROL")

route_esinet_case = find_mode("ROUTE_ESINET", "MISROUTE")
route_esinet_control = find_mode("ROUTE_ESINET", "CONTROL")

route_esz_case = find_mode("ROUTE_ESZ", "MISROUTE")
route_esz_control = find_mode("ROUTE_ESZ", "CONTROL")

fallback_case = find_mode("ROUTE_FALLBACK", "MISROUTE")
fallback_control = find_mode("ROUTE_FALLBACK", "CONTROL")

default_case = find_mode("DEFAULT_ROUTED_CALL", "MISROUTE")
default_control = find_mode("DEFAULT_ROUTED_CALL", "CONTROL")

sip_status_case = find_mode("SIP_STATUS", "MISROUTE")
sip_status_control = find_mode("SIP_STATUS", "CONTROL")

sip_method_case = find_mode("SIP_SIP_METHOD", "MISROUTE")
sip_method_control = find_mode("SIP_SIP_METHOD", "CONTROL")

failure_case = find_mode("FAILURE_SHORT_DR", "MISROUTE")
failure_control = find_mode("FAILURE_SHORT_DR", "CONTROL")

