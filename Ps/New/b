def text_value(row, column):
    if column is None:
        return ""

    value = row.get(column)

    if value is None or pd.isna(value):
        return ""

    value = str(value).strip()

    if value.upper() in {"", "<MISSING>", "NAN", "NONE"}:
        return ""

    return value


def values_differ(row, case_column, control_column):
    case = text_value(row, case_column)
    control = text_value(row, control_column)

    return bool(
        case and control and
        case.upper() != control.upper()
    )


def network_interpretation(row):
    route_case = text_value(row, route_status_case)
    route_control = text_value(row, route_status_control)

    esinet_case = text_value(row, route_esinet_case)
    esinet_control = text_value(row, route_esinet_control)

    esz_case = text_value(row, route_esz_case)
    esz_control = text_value(row, route_esz_control)

    fallback = text_value(row, fallback_case)
    default_route = text_value(row, default_case)

    sip_case = text_value(row, sip_status_case)
    sip_control = text_value(row, sip_status_control)

    ims_case = text_value(row, ims_pcscf_case)
    ims_control = text_value(row, ims_pcscf_control)

    raw_case = text_value(row, raw_ecscf_case)
    raw_control = text_value(row, raw_ecscf_control)

    route_upper = route_case.upper()

    if "ESRK" in route_upper and "MISMATCH" in route_upper:
        return pd.Series({
            "NETWORK_EVIDENCE_SOURCE": "GMLC routing",
            "PRIMARY_NETWORK_SIGN":
                f"ROUTE_STATUS_GMLC={route_case}",
            "WHY_THIS_IS_A_SIGN":
                "The location/eCGI matched, but the ESRK routing result "
                "disagreed. Repetition across the same cells and PSAP pairs "
                "supports an ESRK/ESZ/ESInet-to-PSAP mapping or crosswalk issue.",
            "NETWORK_EVIDENCE_STRENGTH": "STRONG ASSOCIATION"
        })

    if values_differ(row, route_status_case, route_status_control):
        return pd.Series({
            "NETWORK_EVIDENCE_SOURCE": "GMLC routing",
            "PRIMARY_NETWORK_SIGN":
                f"Misroute={route_case}; correct control={route_control}",
            "WHY_THIS_IS_A_SIGN":
                "The dominant GMLC routing outcome differs from similar "
                "correctly routed calls, supporting a routing configuration "
                "or mapping difference.",
            "NETWORK_EVIDENCE_STRENGTH": "STRONG ASSOCIATION"
        })

    if (
        values_differ(row, route_esinet_case, route_esinet_control) or
        values_differ(row, route_esz_case, route_esz_control)
    ):
        return pd.Series({
            "NETWORK_EVIDENCE_SOURCE": "GMLC ESInet/ESZ",
            "PRIMARY_NETWORK_SIGN":
                f"ESInet {esinet_case or 'n/a'} vs "
                f"{esinet_control or 'n/a'}; "
                f"ESZ {esz_case or 'n/a'} vs {esz_control or 'n/a'}",
            "WHY_THIS_IS_A_SIGN":
                "The misroute cohort selects a different ESInet or ESZ than "
                "matched correct calls. This can indicate a stale or incorrect "
                "routing-zone-to-PSAP crosswalk.",
            "NETWORK_EVIDENCE_STRENGTH": "STRONG ASSOCIATION"
        })

    fallback_upper = f"{fallback} {default_route}".upper()
    if (
        "FALLBACK" in fallback_upper or
        fallback_upper.strip() in {"1", "Y", "YES", "TRUE"}
    ):
        return pd.Series({
            "NETWORK_EVIDENCE_SOURCE": "GMLC fallback/default routing",
            "PRIMARY_NETWORK_SIGN":
                f"Fallback={fallback or 'n/a'}; "
                f"default={default_route or 'n/a'}",
            "WHY_THIS_IS_A_SIGN":
                "Fallback or default routing may bypass the normal "
                "cell/ESRK-to-PSAP mapping and route the call to a default PSAP.",
            "NETWORK_EVIDENCE_STRENGTH": "SUPPORTING ASSOCIATION"
        })

    if values_differ(row, sip_status_case, sip_status_control):
        return pd.Series({
            "NETWORK_EVIDENCE_SOURCE": "GMLC SIP signaling",
            "PRIMARY_NETWORK_SIGN":
                f"SIP misroute={sip_case}; correct control={sip_control}",
            "WHY_THIS_IS_A_SIGN":
                "The dominant SIP status differs from correct controls. "
                "This may identify a signaling branch associated with the "
                "routing pattern, but it does not by itself prove the cause.",
            "NETWORK_EVIDENCE_STRENGTH": "SUPPORTING ASSOCIATION"
        })

    if values_differ(row, ims_pcscf_case, ims_pcscf_control):
        return pd.Series({
            "NETWORK_EVIDENCE_SOURCE": "IMS/P-CSCF",
            "PRIMARY_NETWORK_SIGN":
                f"IMS P-CSCF misroute={ims_case}; "
                f"correct control={ims_control}",
            "WHY_THIS_IS_A_SIGN":
                "P-CSCF registration behavior differs from matched correct "
                "calls, so the IMS registration path may be associated with "
                "this cohort.",
            "NETWORK_EVIDENCE_STRENGTH": "SUPPORTING ASSOCIATION"
        })

    if values_differ(row, raw_ecscf_case, raw_ecscf_control):
        return pd.Series({
            "NETWORK_EVIDENCE_SOURCE": "CCDR/E-CSCF",
            "PRIMARY_NETWORK_SIGN":
                f"E-CSCF misroute={raw_case}; correct control={raw_control}",
            "WHY_THIS_IS_A_SIGN":
                "E-CSCF status differs from correct controls and may identify "
                "a core-routing or registration branch associated with the "
                "misroutes.",
            "NETWORK_EVIDENCE_STRENGTH": "SUPPORTING ASSOCIATION"
        })

    return pd.Series({
        "NETWORK_EVIDENCE_SOURCE": "No isolated network field",
        "PRIMARY_NETWORK_SIGN":
            "No single GMLC/IMS/CCDR mode clearly differs from controls",
        "WHY_THIS_IS_A_SIGN":
            "The geometry pattern is strong, but the available network fields "
            "do not isolate one signaling or registration issue. Review the "
            "routing crosswalk and PSAP identifier semantics.",
        "NETWORK_EVIDENCE_STRENGTH": "GEOMETRY EVIDENCE ONLY"
    })


interpretation = ranked.apply(network_interpretation, axis=1)


