    "NETWORK_EVIDENCE_STRENGTH",
    interpretation["NETWORK_EVIDENCE_STRENGTH"].values
)

# Clear rate: definite misroutes divided by strong calls in this row/cohort
misroute_values = pd.to_numeric(
    ranked[misroute_col] if misroute_col else np.nan,
    errors="coerce"
)

strong_values = pd.to_numeric(
    ranked[strong_col] if strong_col else np.nan,
    errors="coerce"
)

network_expert["MISROUTE_RATE_PCT_IN_THIS_COHORT"] = (
    100.0 * misroute_values /
    strong_values.replace(0, np.nan)
).round(2).values

network_expert["CORROBORATION_SCORE_0_TO_100_RULE_BASED"] = (
    pd.to_numeric(
        ranked[score_col] if score_col else np.nan,
        errors="coerce"
    ).round(1).values
)


